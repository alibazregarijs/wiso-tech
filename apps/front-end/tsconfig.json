{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "types": ["jest", "@testing-library/jest-dom", "node"],
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"],
      "@app/*": ["src/app/*"],
      "@/*": ["./src/*"],
      "@lib/*": ["src/lib/*"],
      "@config/*": ["src/config/*"],
      "@features/*": ["src/features/*"],
      "@shared/*": ["src/shared/*"],
      "@styles/*": ["src/styles/*"]
    },
    "moduleResolution": "bundler"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.js",
    ".next/types/**/*.ts",
    "jest.config.ts",
    "jest.setup.ts"
  ],
  "exclude": ["node_modules"]
}
