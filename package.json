{
  "name": "wiso-tech",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "prepare": "husky install"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^8.0.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "turbo": "^2.6.1",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "lint-staged": {
    "apps/front-end/**/*.{ts,tsx,js,jsx}": [
      "pnpm run lint --filter front-end",
      "pnpm run format --filter front-end"
    ],
    "apps/back-end/**/*.{ts,js}": [
      "pnpm run lint --filter back-end",
      "pnpm run format --filter back-end"
    ],
    "packages/ui/**/*.{ts,tsx,js,jsx}": [
      "pnpm run lint --filter ui",
      "pnpm run format --filter ui"
    ]
  }
}
