{
  "name": "ui",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": "./src/*.tsx"
  },
  "scripts": {
    "lint": "eslint app --ext ts,tsx,js,jsx --max-warnings 0",
    "format": "prettier --write \"app/**/*.{ts,tsx,js,jsx,css,md}\"",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit",
    "pre-commit": "lint-staged"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.1",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "lint-staged": {
    "apps/**/*.{ts,tsx,js,jsx,css,md}": [
      "eslint --max-warnings 0 --fix",
      "prettier --write"
    ]
  }
}
